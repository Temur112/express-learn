<%- include('../includes/head.ejs') %>
    <link rel="stylesheet" href="/css/orders.css">
    </head>

    <body>
        <%- include('../includes/navigation.ejs') %>
        <main>
            <div class="orders">
                <% if (orders.length <= 0) { %>
                    <div class="orders__empty">
                        <h1>You have no orders yet.</h1>
                        <a class="btn" href="/shop/products">Browse Products</a>
                    </div>
                <% } else { %>
                    <h1 class="orders__title">Your Orders</h1>
                    <ul class="orders__list">
                        <% orders.forEach(order => { %>
                            <% const total = order.products.reduce((sum, p) => sum + +p.price * p.orderItem.quantity, 0); %>
                            <li class="order">
                                <div class="order__header">
                                    <h2 class="order__id">Order #<%= order.id %></h2>
                                    <span class="order__date"><%= order.createdAt.toLocaleDateString() %></span>
                                </div>
                                <ul class="order__item-list">
                                    <% order.products.forEach(product => { %>
                                        <li class="order__item">
                                            <span class="order__item-qty"><%= product.orderItem.quantity %>&times;</span>
                                            <span class="order__item-title"><%= product.title %></span>
                                            <span class="order__item-price">$<%= (+product.price * product.orderItem.quantity).toFixed(2) %></span>
                                        </li>
                                    <% }); %>
                                </ul>
                                <div class="order__footer">Total: $<%= total.toFixed(2) %></div>
                            </li>
                        <% }); %>
                    </ul>
                <% } %>
            </div>
        </main>
        <%- include('../includes/end.ejs') %>
