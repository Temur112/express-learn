<%- include('../includes/head.ejs') %>
    <link rel="stylesheet" href="/css/cart.css">
    </head>

    <body>
        <%- include('../includes/navigation.ejs') %>
        <main>
            <div class="cart">
                <% if (products.length > 0 ) { %>
                    <% const total = products.reduce((sum, p) => sum + +p.price * p.cartItem.quantity, 0); %>
                    <div class="cart__header">
                        <h1>Your Cart</h1>
                        <span class="cart__count"><%= products.length %> item<%= products.length === 1 ? '' : 's' %></span>
                    </div>
                    <ul class="cart__item-list">
                        <% products.forEach(p => { %>
                            <li class="cart__item">
                                <img class="cart__item-image" src="<%= p.imageUrl %>" alt="<%= p.title %>">
                                <div class="cart__item-info">
                                    <h2 class="cart__item-title"><%= p.title %></h2>
                                    <p class="cart__item-meta">
                                        <span class="cart__item-qty">&times;<%= p.cartItem.quantity %></span>
                                        $<%= p.price %> each
                                    </p>
                                </div>
                                <span class="cart__item-price">$<%= (+p.price * p.cartItem.quantity).toFixed(2) %></span>
                                <form action="/shop/cart-delete" method="post">
                                    <button class="btn" type="submit">Remove</button>
                                    <input type="hidden" name="prodId" value="<%= p.id %>">
                                </form>
                            </li>
                        <% })%>
                    </ul>
                    <div class="cart__summary">
                        <span class="cart__total">Total: $<%= total.toFixed(2) %></span>
                        <a class="btn" href="/shop/checkout">Order Now</a>
                    </div>
                    <form action="/shop/create-order" method="post">
                        <button class="btn" type="submit">Order Now</button>
                    </form>
                <% } else { %>
                    <div class="cart__empty">
                        <h1>No Products in Cart!</h1>
                        <a class="btn" href="/shop/products">Browse Products</a>
                    </div>
                <% } %>
            </div>
        </main>
        <%- include('../includes/end.ejs') %>
